# Rendered by the nginx image entrypoint (envsubst). NGINX_LOCAL_RESOLVERS comes from /etc/resolv.conf
# (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1), so the API address is looked up again when its container is recreated.
server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # The browser only ever calls the API on its own origin, so no CORS configuration is needed.
  location /api/ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    resolver_timeout 2s;
    proxy_connect_timeout 3s;
    set $api_upstream http://api:3000;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 420s;
    add_header Cache-Control "no-store" always;
  }

  # Built files have a content hash in their name, so a new build gets new URLs: they can be cached for a year.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # The page itself (index.html, also served for every app route) is never cached, so each new build is picked up on the next load.
  location / {
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    try_files $uri /index.html;
  }

}
