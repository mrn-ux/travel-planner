# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Required before the first `podman compose up --build`:

# Local Ollama (runs on the host). It must be an address the api CONTAINER can reach:
#   Linux/macOS:            http://host.containers.internal:11434
#   Podman on Windows/WSL:  the Windows host address, e.g. http://172.18.0.1:11434
#                           (podman machine ssh "ip route show default" -> the address after "via")
# and Ollama must listen on all interfaces (OLLAMA_HOST=0.0.0.0).
OLLAMA_BASE_URL=http://host.containers.internal:11434
OLLAMA_MODEL=your-chat-model-with-tool-support
OLLAMA_EMBED_MODEL=nomic-embed-text

# LiteAPI sandbox key (hotel content, rates, bookings; sandbox only)
LITEAPI_API_KEY=your-liteapi-sandbox-key

# Duffel TEST access token (optional): flight offers from Duffel's test environment, sandbox data. Live tokens are refused.
# Without it, flights stay Faro estimates.
# DUFFEL_ACCESS_TOKEN=duffel_test_your-token

# Stripe TEST keys only. The API refuses to start with live keys.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Identifies Faro to Nominatim, Transitous, MediaWiki etc. Include a contact: app/version (contact)
DATA_USER_AGENT=Faro/0.1 (you@example.com)

# ---- Optional (defaults live in compose.yaml; leave empty to disable the feature) ----

# Published web port
# WEB_PORT=8080
# Base URL used in OAuth return addresses (Google redirect URI = <PUBLIC_BASE_URL>/api/auth/google/callback)
# PUBLIC_BASE_URL=http://localhost:8080

# Database (development defaults; the database port is not published to the host)
# POSTGRES_USER=faro
# POSTGRES_PASSWORD=faro
# POSTGRES_DB=faro

# Ollama context window per request
# OLLAMA_NUM_CTX=32768

# Google sign-in (feature disabled and button greyed out when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Booking confirmation email through Gmail (needs a Google app password; empty = "email not sent")
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Protects POST /api/admin/refresh (empty = endpoint disabled)
ADMIN_TOKEN=

# Sessions, scheduler and warm-up
# SESSION_TTL_DAYS=7
# REFRESH_CRON=0 * * * *
# WARMUP_DESTINATIONS=30

# Provider selection (each has exactly one real implementation)
# GUEST_NATIONALITY=US
# HOTEL_PROVIDER=liteapi
# TRANSPORT_PROVIDER=transitous
# MAPS_PROVIDER=osm
# PAYMENT_PROVIDER=stripe
# NOTIFICATION_PROVIDER=gmail
# BOOK_TIMEOUT_MS=20000
